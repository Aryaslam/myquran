{
  "$schema": "https://schema.tauri.app/capabilities/2",
  "identifier": "default",
  "description": "Default capabilities for MyQuran",
  "windows": ["main"],
  "permissions": [
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-open",
    "fs:allow-write",
    "fs:allow-rename",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "core:default",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        "https://mp3quran.net/*",
        "https://*.mp3quran.net/*",
        "https://equran.id/*"
      ]
    }
  ]
}
